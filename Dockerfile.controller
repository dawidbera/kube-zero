# Build stage
FROM golang:1.22-alpine AS builder

WORKDIR /workspace

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY api/ api/
COPY internal/ internal/
COPY cmd/ cmd/

# Compile static binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o /bin/controller ./cmd/controller

# Runtime stage: minimal nonroot distroless
FROM gcr.io/distroless/static:nonroot

WORKDIR /
COPY --from=builder /bin/controller /controller
USER 65532:65532

ENTRYPOINT ["/controller"]
