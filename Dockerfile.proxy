# Build stage
FROM golang:alpine AS builder

WORKDIR /workspace

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY api/ api/
COPY internal/ internal/
COPY cmd/ cmd/

# Compile static binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o /bin/wake-proxy ./cmd/wake-proxy

# Runtime stage: minimal nonroot distroless
FROM gcr.io/distroless/static:nonroot

WORKDIR /
COPY --from=builder /bin/wake-proxy /wake-proxy
USER 65532:65532

EXPOSE 8080 9090

ENTRYPOINT ["/wake-proxy"]
